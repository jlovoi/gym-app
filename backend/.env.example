DATABASE_URL=postgres://gymapp:gymapp@localhost:5432/gymapp
JWT_SECRET=change-me-to-a-long-random-string

# Optional, defaults shown
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
BACKEND_BASE_URL=http://localhost:3000
FRONTEND_REDIRECT_URL=http://localhost:8081/auth/callback

# Google OAuth2 (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI to register: {BACKEND_BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (https://developer.apple.com/account/resources/identifiers/list/serviceId)
# Return URL to register: {BACKEND_BASE_URL}/auth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the contents of the downloaded .p8 private key, with real newlines replaced by literal \n
APPLE_PRIVATE_KEY=
